# Utilisateur
# Pour signer les brouillons de réponse. Vide = partie locale de l'adresse mail.
USER_NAME=
# Coordonnées pour l'en-tête d'un CV/lettre de motivation (career-agent).
# Insérées telles quelles en code, jamais générées par le LLM (un nom ou
# un numéro inventé est un risque bien plus grave qu'un champ vide).
USER_FULL_NAME=
USER_CONTACT_EMAIL=
USER_PHONE=
USER_LINKEDIN=
USER_CITY=

# Messagerie
EMAIL_USER=ton.adresse@gmail.com
# Mot de passe d'application Gmail (PAS ton mot de passe Google) :
# https://myaccount.google.com/apppasswords (nécessite la validation en 2 étapes).
EMAIL_PASS=
IMAP_SERVER=imap.gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# LLM local (Ollama)
OLLAMA_HOST=http://localhost:11434
# LLM_MODEL : modèle léger par défaut (utilisé partout, y compris sur
# Raspberry Pi). LLM_MODEL_HEAVY : escalade pour le routage d'intention,
# UNIQUEMENT si déjà pullé localement (voir is_model_available() dans
# core/src/aelyn/core/llm.py). Jamais sur le Pi, réservé au PC.
#
# Benchmark du 25/09 (10 phrases de routage SYSTEM_INTENT) :
#   mistral:7b      10/10  ~2.6s/appel  <- LLM_MODEL_HEAVY (le plus rapide des 10/10, aucun champ parasite)
#   llama3.1:8b     10/10  ~3.1s/appel  (pollue des champs hors-sujet sur certaines phrases)
#   qwen3:8b        10/10  ~3.9s/appel  (ancien choix, solide en secours)
#   gemma3:4b        8/10  ~4.2s/appel  (latence très irrégulière, 13-15s par endroits)
#   qwen3:4b         7/10  ~1.4s/appel  <- LLM_MODEL (léger, cible Pi)
#   llama3.2:3b      7/10  ~1.4s/appel  (à re-tester directement sur le Pi si qwen3:4b s'avère trop lent)
#   qwen2.5:7b       6/10  ~4.6s/appel
#   gemma3n:e2b      6/10  ~1.5s/appel  (annoncé pour Raspberry Pi 5, pas testé sur le Pi 4 réel)
#   qwen3:1.7b       4/10  ~1.0s/appel
#   phi4-mini:3.8b   4/10  ~0.8s/appel  (ne comprend quasiment pas la commande media)
LLM_MODEL=qwen3:4b
LLM_MODEL_HEAVY=mistral:7b
LLM_TEMPERATURE=0.2
# qwen3 raisonne (lentement) par défaut ; désactivé ici pour un triage rapide.
LLM_THINK=false

# Sécurité (reconnaissance faciale, DeepFace/ArcFace)
FACES_DIR=security-agent/src/faces
# Distance cosinus (0.68 = seuil calibré par DeepFace pour ArcFace).
FACE_MATCH_THRESHOLD=0.68

# Agent carrière
PROFIL_PATH=career-agent/src/aelyn_career/profil.json
# Modèle Ollama utilisé pour le CV/la lettre de motivation (`aelyn pull
# gemma3:4b` ou tout autre tag Ollama valide déjà installé, `ollama
# list` pour vérifier).
#
# Historique des choix, mesuré sur le même poste (GPU 6 Go) à chaque
# fois, voir career-agent/src/aelyn_career/application_writer.py pour le
# détail des tests :
#   deepseek-r1:8b -> mistral:7b : deepseek est un modèle DE RAISONNEMENT
#     (lent, inutilement pour de la rédaction), mistral mesuré ~4x plus
#     rapide à qualité comparable.
#   mistral:7b -> gemma3:4b : sur un test CV structuré identique, mistral
#     a généré un faux poste inventé ("Data Science Engineer chez AP-HP",
#     le nom de l'entreprise visée par l'offre elle-même) que le garde-fou
#     anti-hallucination a dû retirer ; gemma3:4b, même test, 11.5x plus
#     rapide (25.2s contre 288.8s) et RIEN à retirer, chaque chiffre/fait
#     vérifié manuellement contre le vrai profil. Tient aussi entièrement
#     sur le GPU (2.9 Go, jamais de délestage CPU partiel contrairement à
#     mistral:7b), ce qui élimine l'éviction mutuelle avec LLM_MODEL_HEAVY
#     observée sur ce GPU à 6 Go (cf. core/src/aelyn/core/llm.py).
LLM_MODEL_CAREER=gemma3:4b
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDINGS_DIR=career-agent/src/aelyn_career
# "cuda" suppose un GPU NVIDIA disponible (écrit automatiquement par
# install.sh/.ps1 selon le matériel détecté) ; "cpu" marche partout,
# juste plus lent sur une recherche d'offres (embeddings de chaque offre).
EMBEDDING_DEVICE=cuda
# Poids du score final (BM25 + similarité cosinus), doivent sommer à 1.
WEIGHT_SCORE_TXT_MATCH=0.4
WEIGHT_SCORE_COS=0.6
# Nombre de chunks du profil (les mieux notés) pris en compte pour le score
# d'une offre et pour expliquer le match (voir pipeline.py / chunk_label).
TOP_K_CHUNKS=5
# Niveau de la personne qui utilise ce programme : stage, junior, senior
# ou postdoc. Pénalise le score d'une offre trop loin de ce niveau (ex.
# junior -> postdoc), s'adapte à qui l'exécute, jamais codé en dur.
CANDIDATE_LEVEL=junior
# Identifiants de l'application France Travail (https://francetravail.io) :
# https://francetravail.io/produits-partages/catalogue/offres-emploi/documentation
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Mots-clés de recherche, séparés par des virgules (paramètre `motsCles`).
KEYWORDS=Data Scientist,Machine Learning,Intelligence artificielle
# Codes département INSEE à deux chiffres, séparés par des virgules.
DEPARTMENT=35,75
# Sélection des expériences/projets réellement pertinents :
# llm = compréhension sémantique locale (plus pertinent, mais appel LLM
#       lourd à chaque CV/lettre : risque de timeout côté frontend) ;
# keywords = score lexical, rapide et sans appel LLM (par défaut).
APPLICATION_SELECTION_MODE=keywords

# Sources d'offres complémentaires (recherche multi-site, désactivée par
# défaut pour éviter des appels réseau inattendus et respecter les quotas).
# Mettre à true pour agréger les sources configurées avec France Travail.
AELYN_ENABLE_PUBLIC_JOB_APIS=false
JOOBLE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
CAREERJET_API_KEY=
# Optionnels : certains comptes Careerjet exigent ces valeurs.
CAREERJET_USER_IP=
CAREERJET_REFERER=
# RemoteOK, Remotive et Arbeitnow ne demandent pas de clé API.

# Voix (aelyn chat --voix)
# Nom (ou sous-chaîne) d'un micro listé par `sr.Microphone.list_microphone_names()`.
# Laisser vide = périphérique par défaut de PyAudio. Sur Windows, évite
# "Microsoft Sound Mapper - Input" si tu n'es pas capté : cet alias
# générique peut renvoyer du silence pur selon le driver audio.
MICROPHONE_NAME=
# Transcription locale (faster-whisper), tentée avant l'API Google en
# ligne. "cuda" nécessite un GPU NVIDIA (sinon mettre "cpu" ci-dessous,
# ou laisser tel quel : l'échec fait automatiquement basculer sur Google).
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cuda
# Après une réponse d'AELYN, durée (secondes) pendant laquelle elle reste
# active sans redire "Éline" pour continuer à lui parler.
WAKE_TIMEOUT_SECONDS=180

# Média (Freebox Pop / Android TV)
TV_IP_ADRESS=
# Optionnel : chemins du certificat/clé d'appairage. Par défaut générés
# sous ~/.aelyn/ (tv_cert.pem / tv_key.pem).
TV_CERT_FILE=
TV_KEY_FILE=
# Clé API YouTube Data v3, pour GET /media/youtube/search côté aelyn-api
# (https://console.cloud.google.com/apis/credentials, activer "YouTube
# Data API v3" sur le projet). Quota gratuit : 10 000 unités/jour, une
# recherche en coûte 100, largement suffisant pour un usage personnel.
YOUTUBE_API_KEY=

# Caméras locales (test local via OpenCV)
# Index de périphérique vidéo passé à cv2.VideoCapture() pour chaque
# caméra nommée ("montre la caméra de l'entrée/du salon"). IMPORTANT :
# ces index ne sont PAS stables ni devinables sur Windows (dépendent de
# l'ordre de connexion/pilotes) : la webcam intégrée et Iriun Webcam
# peuvent être 0/1 dans un sens ou dans l'autre selon la machine.
# Vérifie le bon index chez toi avec :
#   cd media-agent && uv run python scripts/list_cameras.py
# avant de faire confiance aux valeurs par défaut ci-dessous.
CAMERA_ENTREE_INDEX=0
CAMERA_SALON_INDEX=1

# Garde-fous
# Tant que c'est à false, aucun mail n'est envoyé sans validation manuelle.
ALLOW_AUTONOMOUS_SEND=false
MAX_MAILS_PER_RUN=15
# Code demandé par aelyn-api avant toute modification des réglages
# (POST /settings/auth -> jeton temporaire -> PATCH /settings/*). Vide =
# l'API refuse TOUTE modification (jamais ouvert par défaut).
SETTINGS_PASSKEY=
