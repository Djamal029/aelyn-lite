# URL de base de l'API aelyn-api (voir src/backend/aelyn-api). Valeur par
# défaut correcte pour un lancement local standard (uvicorn sur le port
# 8001, cf. src/backend/scripts/start.sh/.ps1).
VITE_API_BASE_URL=http://localhost:8001

# "true" masque les sections Caméras et Raspberry Pi de l'UI (matériel que
# tu n'as probablement pas). Laisse vide/false pour garder tout visible.
VITE_LITE_MODE=false
